# Local infrastructure ports (Docker Compose)
MONGO_PORT=27017
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Backend runtime environment variables (copy to .env — never commit real secrets)
RMAP_MONGODB_URI=mongodb://localhost:27017/rmap?replicaSet=rs0
RMAP_REDIS_HOST=localhost
RMAP_REDIS_PORT=6379
RMAP_MAIL_HOST=localhost
RMAP_MAIL_PORT=1025
RMAP_MAIL_FROM=no-reply@rmap.local

# Must be >= 32 bytes (256-bit) base64 or UTF-8 secret in non-local environments
RMAP_JWT_SECRET=change-me-in-local-env-minimum-32-bytes-long-secret
RMAP_JWT_ACCESS_TTL_SECONDS=900
RMAP_JWT_REFRESH_TTL_SECONDS=604800

# Optional bootstrap admin account for local development only (leave unset in production)
RMAP_BOOTSTRAP_ADMIN_EMAIL=
RMAP_BOOTSTRAP_ADMIN_PASSWORD=

# Payment provider boundary (unconfigured by default; never commit real keys)
RMAP_PAYMENT_PROVIDER=unconfigured
RMAP_PAYMENT_WEBHOOK_SECRET=

# Phase 2+ Gemini API configuration (backend-only; never expose to clients)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
RMAP_AI_DAILY_TOKEN_QUOTA=250000
